        "#Calcular area de rectangulo\n",
        "def area_rectangulo(base, altura):\n",
        "    area = base * altura\n",
        "    return area\n",
        "\n",
        "base = 10\n",
        "altura = 5\n",
        "\n",
        "area = area_rectangulo(base, altura)\n",
        "print(\"El area de rectangulo es:\", area)"
